# External APIs for ComplyRisk AI audit pipeline
# OpenRouter: Jev probability model + GPT VaR synthesis share this key
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=~typesafe/jev-latest
OPENROUTER_VAR_MODEL=~openai/gpt-sol-latest
# Optional: voiced briefing (backend only, never VITE_*)
ELEVENLABS_API_KEY=

# Devin PR hand-off: service user key (cog_...), its org, and a GitHub token
# with Contents + Pull requests read/write on the target repo.
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_MAX_ACU=10
GITHUB_TOKEN=
# normal | fast | fusion | lite | ultra | swe-2-medium | swe-2-high | swe-2-max
DEVIN_MODE=normal
